# API
ZIPCRYPT_HTTP_ADDR=:8080
ZIPCRYPT_ENVIRONMENT=development
ZIPCRYPT_LOG_LEVEL=info

# Infrastructure (these values match compose.yaml)
ZIPCRYPT_DATABASE_URL=postgres://zipcrypt:zipcrypt@localhost:5432/zipcrypt?sslmode=disable
ZIPCRYPT_REDIS_ADDR=localhost:6379
ZIPCRYPT_S3_ENDPOINT=localhost:9000
ZIPCRYPT_S3_ACCESS_KEY=zipcrypt
ZIPCRYPT_S3_SECRET_KEY=zipcrypt-local-development-only
ZIPCRYPT_S3_BUCKET=zipcrypt
ZIPCRYPT_S3_USE_SSL=false
